#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY_ROOT=""

if [ -d "${SCRIPT_DIR}/kite_settings" ]; then
    PY_ROOT="${SCRIPT_DIR}"
elif [ -d "${SCRIPT_DIR}/../share/kite-shell/settings/kite_settings" ]; then
    PY_ROOT="$(cd "${SCRIPT_DIR}/../share/kite-shell/settings" && pwd)"
elif [ -d "/usr/local/share/kite-shell/settings/kite_settings" ]; then
    PY_ROOT="/usr/local/share/kite-shell/settings"
elif [ -d "/usr/share/kite-shell/settings/kite_settings" ]; then
    PY_ROOT="/usr/share/kite-shell/settings"
fi

if [ -n "${PY_ROOT}" ]; then
    export PYTHONPATH="${PY_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
fi

PYTHON_BIN="${KITE_PYTHON:-}"
if [ -z "${PYTHON_BIN}" ]; then
    if command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="python3"
    elif command -v python >/dev/null 2>&1; then
        PYTHON_BIN="python"
    else
        echo "Error: python3/python not found (set KITE_PYTHON)." >&2
        exit 1
    fi
fi

if [ "${1:-}" = "--cli" ]; then
    shift
    exec "${PYTHON_BIN}" -m kite_settings.cli "$@"
fi

if [ "$#" -gt 0 ]; then
    exec "${PYTHON_BIN}" -m kite_settings.cli "$@"
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v quickshell >/dev/null 2>&1; then
    APP_QML="${SCRIPT_DIR}/SettingsApp.qml"
    if [ ! -f "${APP_QML}" ] && [ -n "${PY_ROOT}" ]; then
        APP_QML="${PY_ROOT}/SettingsApp.qml"
    fi
    exec quickshell -p "${APP_QML}"
fi

exec "${PYTHON_BIN}" -m kite_settings.cli show
