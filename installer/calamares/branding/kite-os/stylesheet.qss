/* KITE_OS Calamares Glass UI Theme - Aero Blue (#38BDF8) */

QWidget,
QMainWindow,
QDialog {
    background-color: #0B1120;
    color: #F8FAFC;
    font-family: "Segoe UI Variable", "Inter", "Noto Sans", sans-serif;
    font-size: 10pt;
}

#sidebarApp {
    background-color: rgba(15, 23, 42, 235);
    border-right: 1px solid rgba(255, 255, 255, 38);
    padding: 12px 8px;
}

#mainApp,
QStackedWidget {
    background-color: rgba(11, 17, 32, 228);
    border-radius: 12px;
}

QGroupBox,
QFrame {
    background-color: rgba(30, 41, 59, 192);
    border: 1px solid rgba(255, 255, 255, 42);
    border-radius: 12px;
}

QLabel {
    background-color: transparent;
    border: none;
    color: #E2E8F0;
}

QPushButton {
    background-color: rgba(30, 41, 59, 210);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 45);
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(56, 189, 248, 48);
    border: 1px solid #38BDF8;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: rgba(2, 132, 199, 160);
    border: 1px solid #7DD3FC;
}

QPushButton:default {
    background-color: rgba(56, 189, 248, 195);
    border: 1px solid #7DD3FC;
    color: #0B1120;
}

QPushButton:default:hover {
    background-color: #7DD3FC;
    border: 1px solid #BAE6FD;
}

QPushButton:disabled {
    background-color: rgba(15, 23, 42, 140);
    border: 1px solid rgba(255, 255, 255, 18);
    color: #64748B;
}

QLineEdit,
QComboBox,
QSpinBox,
QListView,
QTreeView,
QTableView {
    background-color: rgba(15, 23, 42, 215);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 8px;
    padding: 5px 10px;
    selection-background-color: rgba(56, 189, 248, 95);
    selection-color: #F8FAFC;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QListView:focus,
QTreeView:focus {
    border: 1px solid #38BDF8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: rgba(15, 23, 42, 245);
    border: 1px solid rgba(56, 189, 248, 140);
    border-radius: 8px;
    color: #F8FAFC;
}

QProgressBar {
    background-color: rgba(30, 41, 59, 210);
    border: 1px solid rgba(255, 255, 255, 38);
    border-radius: 6px;
    text-align: center;
    color: #F8FAFC;
    min-height: 14px;
}

QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0284C7,
        stop: 1 #38BDF8
    );
}

QRadioButton,
QCheckBox {
    color: #E2E8F0;
    spacing: 8px;
}

QRadioButton::indicator,
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: rgba(15, 23, 42, 220);
    border: 1px solid rgba(255, 255, 255, 65);
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator:checked,
QCheckBox::indicator:checked {
    background-color: #38BDF8;
    border: 1px solid #7DD3FC;
}

QScrollBar:vertical {
    background: rgba(15, 23, 42, 120);
    width: 8px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(56, 189, 248, 125);
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(125, 211, 252, 180);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
